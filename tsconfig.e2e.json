{
  "extends": "./tsconfig.base.json",
  "include": [
    "e2e/**/*",
    "app/language-names.ts",
    "app/paraglide/runtime.d.ts",
    "app/result.ts",
    "app/sentences.ts",
    "app/value-parsers.ts",
    "app/value-shapes.ts",
    "scripts/wait-for-health.ts",
    "app/time-units.ts",
    "app/features/accounts/printed-password-for-test.ts",
    "app/features/accounts/account-actions.ts"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.e2e.tsbuildinfo",
    "lib": ["DOM", "ES2024"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true
  }
}
