{
  "extends": "./tsconfig.base.json",
  "include": [
    "server/main.ts",
    "server/account.ts",
    "server/server-options.ts",
    "server/server-options.test.ts",
    "app/database/database.server.ts",
    "app/database/migrations-folder-name.ts",
    "app/error-message.ts",
    "app/exit-with-failure.server.ts",
    "app/features/accounts/account-command.server.ts",
    "app/features/accounts/account-limits.ts",
    "app/features/accounts/account-store.server.ts",
    "app/features/accounts/account.ts",
    "app/features/accounts/accounts.schema.ts",
    "app/features/accounts/password.server.ts",
    "app/features/accounts/session-store.server.ts",
    "app/features/accounts/username.ts",
    "app/random-text.server.ts",
    "app/write-log.server.ts",
    "app/result.ts",
    "app/sentences.ts",
    "app/value-parsers.ts",
    "app/value-shapes.ts",
    "e2e/test-server.ts",
    "scripts/**/*.ts",
    "lint/**/*.ts",
    "*.config.ts",
    "eslint.config.test.ts",
    "project.inlang/paraglide.config.ts"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo",
    "lib": ["ES2024"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true
  }
}
